                            "id": "client_html_grid",
                            "settings": {
                                "html": "<style>\n.aries-client-portfolio-section {\n    position: relative;\n    overflow: hidden;\n}\n.aries-client-portfolio-section::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background-image: url('/wp-content/uploads/2026/05/aries-logo.png');\n    background-repeat: repeat;\n    background-size: 180px 180px;\n    background-position: center center;\n    opacity: 0.03;\n    pointer-events: none;\n    z-index: 0;\n}\n.aries-client-portfolio-section > .elementor-container {\n    position: relative;\n    z-index: 1;\n}\n\n/* ── Logo Grid ── */\n.aries-logo-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 24px;\n    max-width: 1140px;\n    margin: 0 auto 80px auto;\n    padding: 0 20px;\n}\n.aries-logo-card {\n    background: #ffffff;\n    border: 1px solid #DDDDDD;\n    border-radius: 10px;\n    box-shadow: 0 2px 12px rgba(0,0,0,0.06);\n    aspect-ratio: 1 / 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 24px;\n    transition: box-shadow 0.3s ease, transform 0.3s ease;\n    position: relative;\n    overflow: hidden;\n}\n.aries-logo-card:hover {\n    box-shadow: 0 6px 24px rgba(0,0,0,0.1);\n    transform: translateY(-3px);\n}\n\n/* ── Faena Special Card ── */\n.aries-logo-card.faena-card {\n    background: #c91c1c;\n    border-color: #c91c1c;\n}\n.aries-logo-card .logo-text-primary {\n    font-family: 'Inter', sans-serif;\n    font-weight: 700;\n    font-size: 16px;\n    letter-spacing: 5px;\n    text-transform: uppercase;\n    color: #222222;\n    text-align: center;\n    line-height: 1.4;\n}\n.aries-logo-card .logo-text-secondary {\n    font-family: 'Inter', sans-serif;\n    font-weight: 400;\n    font-size: 10px;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: #777777;\n    text-align: center;\n    margin-top: 4px;\n    line-height: 1.3;\n}\n.aries-logo-card.faena-card .logo-text-primary {\n    color: #ffffff;\n    font-size: 22px;\n    letter-spacing: 10px;\n    font-weight: 300;\n}\n\n/* ── Logo Symbol SVG ── */\n.logo-symbol {\n    margin-bottom: 8px;\n}\n.logo-symbol svg {\n    width: 32px;\n    height: 32px;\n}\n\n/* ── Event Portfolio ── */\n.aries-event-heading {\n    text-align: center;\n    margin-bottom: 28px;\n}\n.aries-event-list {\n    text-align: center;\n    max-width: 1140px;\n    margin: 0 auto;\n    padding: 0 20px;\n}\n.aries-event-list span {\n    font-family: 'Inter', sans-serif;\n    font-weight: 500;\n    font-size: 14px;\n    color: #c91c1c;\n    letter-spacing: 1.5px;\n    text-transform: uppercase;\n}\n.aries-event-list .event-separator {\n    display: inline-block;\n    margin: 0 16px;\n    opacity: 0.7;\n    font-size: 13px;\n    vertical-align: middle;\n}\n.aries-event-list .event-separator svg {\n    width: 14px;\n    height: 14px;\n    fill: #c91c1c;\n    vertical-align: middle;\n}\n\n/* ── Responsive ── */\n@media (max-width: 1024px) {\n    .aries-logo-grid {\n        grid-template-columns: repeat(3, 1fr);\n        gap: 18px;\n    }\n}\n@media (max-width: 767px) {\n    .aries-logo-grid {\n        grid-template-columns: repeat(2, 1fr);\n        gap: 14px;\n    }\n    .aries-logo-card .logo-text-primary { font-size: 12px; }\n    .aries-logo-card .logo-text-secondary { font-size: 8px; }\n    .aries-event-list span { font-size: 11px; letter-spacing: 1px; }\n    .aries-event-list .event-separator { margin: 0 8px; }\n}\n</style>\n\n<div class=\"aries-logo-grid\">\n\n    <!-- Row 1, Col 1: FAENA -->\n    <div class=\"aries-logo-card faena-card\">\n        <div class=\"logo-text-primary\">FAENA</div>\n    </div>\n\n    <!-- Row 1, Col 2: east MIAMI -->\n    <div class=\"aries-logo-card\">\n        <div>\n            <div class=\"logo-text-primary\" style=\"font-weight:300; letter-spacing:6px; font-size:18px;\">east</div>\n            <div class=\"logo-text-primary\" style=\"font-weight:700; letter-spacing:4px; font-size:13px; margin-top:2px;\">MIAMI</div>\n        </div>\n    </div>\n\n    <!-- Row 1, Col 3: THE GOODLAND (Kimpton) -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-symbol\">\n                <svg viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <circle cx=\"16\" cy=\"16\" r=\"14\" stroke=\"#222222\" stroke-width=\"1.5\" fill=\"none\"/>\n                    <path d=\"M10 16 L16 10 L22 16 L16 22 Z\" fill=\"#222222\"/>\n                </svg>\n            </div>\n            <div class=\"logo-text-primary\" style=\"font-size:13px; letter-spacing:3px;\">THE GOODLAND</div>\n            <div class=\"logo-text-secondary\">Kimpton</div>\n            <div class=\"logo-text-secondary\" style=\"font-size:8px; margin-top:2px;\">Fort Lauderdale Beach</div>\n        </div>\n    </div>\n\n    <!-- Row 1, Col 4: FONTAINEBLEAU -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-symbol\">\n                <svg viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path d=\"M16 2 L20 12 L16 8 L12 12 Z\" fill=\"#222222\"/>\n                    <path d=\"M8 14 L24 14 L22 18 L10 18 Z\" fill=\"#222222\" opacity=\"0.6\"/>\n                </svg>\n            </div>\n            <div class=\"logo-text-primary\" style=\"font-size:11px; letter-spacing:4px; font-weight:300;\">FONTAINEBLEAU</div>\n            <div class=\"logo-text-secondary\">Miami Beach</div>\n        </div>\n    </div>\n\n    <!-- Row 1, Col 5: MARGARITAVILLE -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-symbol\">\n                <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <circle cx=\"20\" cy=\"14\" r=\"5\" fill=\"#27ae60\"/>\n                    <path d=\"M15 18 Q20 28 25 18\" stroke=\"#e67e22\" stroke-width=\"2\" fill=\"none\"/>\n                    <path d=\"M18 10 Q20 4 22 10\" stroke=\"#c91c1c\" stroke-width=\"1.5\" fill=\"none\"/>\n                    <circle cx=\"20\" cy=\"14\" r=\"2\" fill=\"#f1c40f\"/>\n                </svg>\n            </div>\n            <div class=\"logo-text-primary\" style=\"font-size:11px; letter-spacing:3px;\">MARGARITAVILLE</div>\n        </div>\n    </div>\n\n    <!-- Row 2, Col 1: THE WESTIN -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-text-primary\" style=\"font-size:14px; letter-spacing:5px; font-weight:300;\">THE WESTIN</div>\n            <div class=\"logo-text-secondary\">Fort Lauderdale Beach Resort</div>\n        </div>\n    </div>\n\n    <!-- Row 2, Col 2: THE ESTATES AT ACQUALINA -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-symbol\">\n                <svg viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <path d=\"M16 4 L28 28 L4 28 Z\" stroke=\"#b8860b\" stroke-width=\"1.2\" fill=\"none\"/>\n                    <path d=\"M16 10 L23 26 L9 26 Z\" stroke=\"#b8860b\" stroke-width=\"0.8\" fill=\"none\"/>\n                    <circle cx=\"16\" cy=\"20\" r=\"3\" stroke=\"#b8860b\" stroke-width=\"0.8\" fill=\"none\"/>\n                </svg>\n            </div>\n            <div class=\"logo-text-primary\" style=\"font-size:10px; letter-spacing:3px; color:#b8860b;\">THE ESTATES AT</div>\n            <div class=\"logo-text-primary\" style=\"font-size:12px; letter-spacing:4px; color:#b8860b; font-weight:600; margin-top:2px;\">ACQUALINA</div>\n        </div>\n    </div>\n\n    <!-- Row 2, Col 3: AMLI RESIDENTIAL -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-text-primary\" style=\"font-size:16px; letter-spacing:4px; font-weight:700;\">AMLI</div>\n            <div class=\"logo-text-secondary\" style=\"font-size:9px; letter-spacing:3px;\">RESIDENTIAL</div>\n        </div>\n    </div>\n\n    <!-- Row 2, Col 4: HXECUTE -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-symbol\">\n                <svg viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <polygon points=\"16,2 28,9 28,23 16,30 4,23 4,9\" stroke=\"#222222\" stroke-width=\"1.5\" fill=\"none\"/>\n                    <polygon points=\"16,8 22,12 22,20 16,24 10,20 10,12\" stroke=\"#222222\" stroke-width=\"0.8\" fill=\"none\" opacity=\"0.5\"/>\n                </svg>\n            </div>\n            <div class=\"logo-text-primary\" style=\"font-size:14px; letter-spacing:5px;\">HXECUTE</div>\n        </div>\n    </div>\n\n    <!-- Row 2, Col 5: UBS -->\n    <div class=\"aries-logo-card\">\n        <div style=\"text-align:center;\">\n            <div class=\"logo-symbol\">\n                <svg viewBox=\"0 0 32 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n                    <rect x=\"10\" y=\"6\" width=\"12\" height=\"7\" rx=\"1\" stroke=\"#222222\" stroke-width=\"1.5\" fill=\"none\"/>\n                    <rect x=\"13\" y=\"13\" width=\"6\" height=\"10\" rx=\"0\" stroke=\"#222222\" stroke-width=\"1.5\" fill=\"none\"/>\n                    <circle cx=\"16\" cy=\"9.5\" r=\"1.5\" fill=\"#222222\"/>\n                    <line x1=\"14\" y1=\"6\" x2=\"14\" y2=\"3\" stroke=\"#222222\" stroke-width=\"1\"/>\n                    <line x1=\"18\" y1=\"6\" x2=\"18\" y2=\"3\" stroke=\"#222222\" stroke-width=\"1\"/>\n                </svg>\n            </div>\n            <div class=\"logo-text-primary\" style=\"font-size:20px; letter-spacing:4px; font-weight:700;\">UBS</div>\n        </div>\n    </div>\n\n</div>",
                                "css_classes": ""
                            },
